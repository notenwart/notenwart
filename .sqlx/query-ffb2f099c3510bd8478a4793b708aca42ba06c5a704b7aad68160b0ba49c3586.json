  "query": "SELECT e.id, e.name, m.leader, '/api/images/' || e.logo_id AS logo_url, e.symbol, e.color\n         FROM ensemble_members m JOIN ensembles e ON e.id = m.ensemble_id\n         WHERE m.user_id = $1 AND e.organization_id = $2 ORDER BY lower(e.name)",
