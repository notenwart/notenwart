{
	"extends": "@tsconfig/svelte/tsconfig.json",
	"compilerOptions": {
		"target": "ES2024",
		"lib": ["ES2024", "DOM", "DOM.Iterable"],
		"module": "ESNext",
		"moduleResolution": "bundler",
		"strict": true,
		"verbatimModuleSyntax": true,
		"skipLibCheck": true,
		"types": ["svelte", "vite/client", "node"]
	},
	"include": [
		"src/**/*.ts",
		"src/**/*.svelte",
		"vite.config.ts",
		"service-worker.plugin.ts",
		"service-worker.plugin.test.ts"
	]
}
